# Base de données locale simple. Pour prod, remplace par PostgreSQL si besoin.
DATABASE_URL="file:./dev.db"

# Secret utilisé par /api/cron/scrape-tcg
CRON_SECRET="change-moi-long-et-secret"

# Session Playwright sauvegardée après connexion manuelle TCG.
TCG_STORAGE_STATE_PATH="storage/tcg-auth.json"
TCG_BASE_URL="https://tcgdistribution.fr"

# Ton site public à comparer.
OWN_SITE_BASE_URL="https://cartespokemon.com"
OWN_SITE_DEFAULT_LISTING_URL="https://cartespokemon.com/collections/all"

# Paramètres scraper.
SCRAPE_DELAY_MS="2500"
SCRAPE_MAX_PRODUCTS="260"
DISCOVER_FROM_WATCH_URLS="true"
TCG_DISCOVER_MAX_PAGES="12"
OWN_DISCOVER_MAX_PAGES="12"
OWN_SCRAPE_MAX_PRODUCTS="260"

# Optionnel : alerte Discord quand un prix change.
DISCORD_WEBHOOK_URL=""

# Optionnel : exécuter Chromium avec moins de sandbox en Docker/VPS.
PLAYWRIGHT_NO_SANDBOX="false"

# Debug: si true, sauvegarde HTML/screenshot/signaux quand un prix n’est pas trouvé.
SCRAPER_DEBUG="false"
SCRAPER_DEBUG_DIR="storage/debug"

# Veille prix claire
SCRAPE_DELAY_MS="350"
TCG_DISCOVER_MAX_PAGES="12"
CPC_DISCOVER_MAX_PAGES="12"
REFRESH_MAX_PRODUCTS="300"

# Pour récupérer les prix TCGD connectés en local
TCG_STORAGE_STATE_PATH="storage/tcg-auth.json"

# Pour Vercel, colle soit le cookie fournisseur complet, soit le JSON storageState
TCG_COOKIE_HEADER=""
TCG_STORAGE_STATE_JSON=""
CPC_SUPPLIER_FACTOR=0.88
AUTO_MATCH_THRESHOLD="82"
CPC_SUPPLIER_FACTOR_2000=0.77
